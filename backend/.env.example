PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Ambos proyectos originales usan SSL con rejectUnauthorized:false.
# Para MySQL local sin TLS, cambia DB_SSL a false.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Fechas de negocio: zona horaria local del proceso, igual que el original.
